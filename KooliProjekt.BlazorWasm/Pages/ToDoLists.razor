@page "/lists"
@inject IApiClient apiClient

<PageTitle>ToDo Lists</PageTitle>

<h1>ToDo Lists</h1>

@if (todoLists == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var todoList in todoLists)
            {
                <tr>
                    <td>@todoList.Id</td>
                    <td>@todoList.Title</td>
                    <td>
                        <button class="btn btn-success">Edit</button>
                        <button class="btn btn-danger">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IList<Project> todoLists;

    protected override async Task OnInitializedAsync()
    {
        var result = await apiClient.List(1, 100);
        todoLists = result.Value.Results;
    }
}
